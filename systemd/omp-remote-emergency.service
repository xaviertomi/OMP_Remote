[Unit]
Description=OMP Remote emergency kill/status API
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/omp-remote/server.env

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/omp-remote
Environment=PYTHONPATH=/opt/omp-remote/server
EnvironmentFile=/etc/omp-remote/server.env
ExecStart=/opt/omp-remote/server/.venv/bin/python -m omp_remote emergency
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/omp-remote /run/omp-remote
RuntimeDirectory=omp-remote-emergency

[Install]
WantedBy=multi-user.target
